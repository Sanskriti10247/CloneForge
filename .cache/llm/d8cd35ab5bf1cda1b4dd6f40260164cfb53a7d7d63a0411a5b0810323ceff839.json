{"text":"<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap');\n\n:root {\n    --s-primary: #004ce5;\n    --s-primary-soft: rgba(0, 76, 229, 0.1);\n    --s-dark-blue: #011a53;\n    --s-text-main: #121212;\n    --s-text-muted: #4a4a4a; /* Increased contrast from #616161 */\n    --s-bg-light: #f5f5f5;\n    --s-card-bg: #ffffff;\n    --s-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.s-features-section {\n    font-family: 'Plus Jakarta Sans', 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;\n    background-color: var(--s-bg-light);\n    padding: 100px 120px;\n    color: var(--s-text-main);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    overflow: hidden;\n}\n\n.s-features-container {\n    max-width: 1280px;\n    width: 100%;\n    margin: 0 auto;\n}\n\n.s-features-header {\n    margin-bottom: 70px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n}\n\n.s-features-badge {\n    font-size: 14px;\n    font-weight: 700;\n    color: var(--s-primary);\n    text-transform: uppercase;\n    letter-spacing: 1.5px;\n    margin-bottom: 16px;\n    display: inline-block;\n    padding: 6px 12px;\n    background: var(--s-primary-soft);\n    border-radius: 100px;\n}\n\n.s-features-title {\n    font-size: 56px;\n    font-weight: 800;\n    color: var(--s-dark-blue);\n    margin-bottom: 24px;\n    line-height: 1.1;\n    letter-spacing: -1px;\n}\n\n.s-features-subtitle {\n    font-size: 20px;\n    color: var(--s-text-muted);\n    max-width: 720px;\n    margin: 0 auto;\n    line-height: 1.6;\n    font-weight: 400;\n}\n\n.s-features-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 32px;\n}\n\n.s-features-card {\n    background: linear-gradient(145deg, #ffffff, #fafafa);\n    padding: 48px 32px;\n    border-radius: 24px;\n    text-align: left;\n    transition: var(--s-transition);\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);\n    border: 1px solid rgba(0, 0, 0, 0.06);\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n    cursor: default;\n    position: relative;\n}\n\n.s-features-card:hover {\n    transform: translateY(-12px) scale(1.02);\n    box-shadow: 0 20px 40px rgba(0, 76, 229, 0.08);\n    border-color: var(--s-primary);\n}\n\n.s-features-icon-wrapper {\n    width: 64px;\n    height: 64px;\n    background: var(--s-primary-soft);\n    border-radius: 16px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 32px;\n    transition: var(--s-transition);\n}\n\n.s-features-icon-wrapper svg {\n    width: 32px;\n    height: 32px;\n    stroke: var(--s-primary);\n    stroke-width: 2;\n    fill: none;\n    transition: var(--s-transition);\n}\n\n.s-features-card:hover .s-features-icon-wrapper {\n    background: var(--s-primary);\n}\n\n.s-features-card:hover .s-features-icon-wrapper svg {\n    stroke: #ffffff;\n}\n\n.s-features-card-title {\n    font-size: 24px;\n    font-weight: 700;\n    color: var(--s-dark-blue);\n    margin-bottom: 16px;\n    line-height: 1.3;\n}\n\n.s-features-card-text {\n    font-size: 17px;\n    color: var(--s-text-muted);\n    line-height: 1.6;\n    margin: 0;\n    font-weight: 400;\n}\n\n@media (max-width: 1200px) {\n    .s-features-section {\n        padding: 80px 60px;\n    }\n    .s-features-grid {\n        grid-template-columns: repeat(2, 1fr);\n    }\n}\n\n@media (max-width: 768px) {\n    .s-features-section {\n        padding: 80px 30px;\n    }\n    .s-features-title {\n        font-size: 40px;\n    }\n    .s-features-subtitle {\n        font-size: 18px;\n    }\n}\n\n@media (max-width: 480px) {\n    .s-features-grid {\n        grid-template-columns: 1fr;\n    }\n    .s-features-title {\n        font-size: 32px;\n    }\n    .s-features-section {\n        padding: 60px 20px;\n    }\n}\n</style>\n\n<section class=\"s-features-section\">\n    <div class=\"s-features-container\">\n        <div class=\"s-features-header\">\n            <span class=\"s-features-badge\">Why Scaler</span>\n            <h2 class=\"s-features-title\">Built Different, Designed to Last</h2>\n            <p class=\"s-features-subtitle\">The investment that compounds. Scaler gives you strong technical foundations, AI integrated at every stage, and a curriculum that evolves as the market does.</p>\n        </div>\n\n        <div class=\"s-features-grid\">\n            <!-- Feature 1 -->\n            <div class=\"s-features-card\">\n                <div class=\"s-features-icon-wrapper\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 8V4H8\"/><rect width=\"16\" height=\"12\" x=\"4\" y=\"8\" rx=\"2\"/><path d=\"M2 14h2\"/><path d=\"M20 14h2\"/><path d=\"M15 13v2\"/><path d=\"M9 13v2\"/></svg>\n                </div>\n                <h3 class=\"s-features-card-title\">AI Integrated Learning</h3>\n                <p class=\"s-features-card-text\">Master AI tools and workflows integrated into every stage of your learning journey to stay ahead of the curve.</p>\n            </div>\n\n            <!-- Feature 2 -->\n            <div class=\"s-features-card\">\n                <div class=\"s-features-icon-wrapper\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z\"/><path d=\"M8 7h6\"/><path d=\"M8 11h8\"/></svg>\n                </div>\n                <h3 class=\"s-features-card-title\">Evolving Curriculum</h3>\n                <p class=\"s-features-card-text\">A dynamic syllabus that updates in real-time based on industry shifts and emerging technological trends.</p>\n            </div>\n\n            <!-- Feature 3 -->\n            <div class=\"s-features-card\">\n                <div class=\"s-features-icon-wrapper\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"/><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"/></svg>\n                </div>\n                <h3 class=\"s-features-card-title\">Technical Foundations</h3>\n                <p class=\"s-features-card-text\">Deep dive into computer science fundamentals that provide the stability to learn any new language or framework.</p>\n            </div>\n\n            <!-- Feature 4 -->\n            <div class=\"s-features-card\">\n                <div class=\"s-features-icon-wrapper\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z\"/><path d=\"m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2Z\"/><path d=\"M9 12H4\"/><path d=\"M12 15H7\"/></svg>\n                </div>\n                <h3 class=\"s-features-card-title\">Career Acceleration</h3>\n                <p class=\"s-features-card-text\">Strategic placement support and mentorship from industry veterans to land roles at top-tier tech companies.</p>\n            </div>\n        </div>\n    </div>\n</section>","model":"gemma-4-31b-it","ts":1778074368680}