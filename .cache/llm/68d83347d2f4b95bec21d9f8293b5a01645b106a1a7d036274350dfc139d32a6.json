{"text":"<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n:root {\n    --s-header-bg: #ffffff;\n    --s-header-text: #011a53;\n    --s-header-accent: #004ce5;\n    --s-header-accent-hover: #003bb3;\n    --s-header-text-muted: #616161;\n    --s-header-font: 'Inter', sans-serif; /* Fallback for clashGrotesk */\n}\n\n.s-header-wrapper {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 70px;\n    background-color: var(--s-header-bg);\n    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.05);\n    z-index: 1000;\n    font-family: var(--s-header-font);\n    display: flex;\n    align-items: center;\n    transition: all 0.3s ease;\n}\n\n.s-header-container {\n    width: 100%;\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 0 40px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n}\n\n.s-header-logo {\n    font-size: 24px;\n    font-weight: 700;\n    color: var(--s-header-text);\n    text-decoration: none;\n    letter-spacing: -0.5px;\n    display: flex;\n    align-items: center;\n}\n\n.s-header-nav {\n    display: flex;\n    align-items: center;\n    gap: 32px;\n}\n\n.s-header-menu {\n    display: flex;\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    gap: 24px;\n    align-items: center;\n}\n\n.s-header-link {\n    text-decoration: none;\n    color: var(--s-header-text);\n    font-size: 13px;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    transition: color 0.3s ease;\n}\n\n.s-header-link:hover {\n    color: var(--s-header-accent);\n}\n\n.s-header-actions {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n}\n\n.s-header-btn-secondary {\n    text-decoration: none;\n    color: var(--s-header-text);\n    font-size: 14px;\n    font-weight: 600;\n    transition: all 0.3s ease;\n}\n\n.s-header-btn-secondary:hover {\n    color: var(--s-header-accent);\n}\n\n.s-header-btn-primary {\n    background-color: var(--s-header-accent);\n    color: #ffffff;\n    padding: 10px 24px;\n    border-radius: 6px;\n    text-decoration: none;\n    font-size: 14px;\n    font-weight: 600;\n    transition: all 0.3s ease;\n    border: 2px solid var(--s-header-accent);\n}\n\n.s-header-btn-primary:hover {\n    background-color: var(--s-header-accent-hover);\n    border-color: var(--s-header-accent-hover);\n    transform: translateY(-1px);\n    box-shadow: 0 4px 12px rgba(0, 76, 229, 0.2);\n}\n\n.s-header-hamburger {\n    display: none;\n    cursor: pointer;\n    flex-direction: column;\n    gap: 5px;\n    z-index: 1100;\n}\n\n.s-header-hamburger span {\n    display: block;\n    width: 25px;\n    height: 3px;\n    background-color: var(--s-header-text);\n    border-radius: 3px;\n    transition: all 0.3s ease;\n}\n\n@media (max-width: 1024px) {\n    .s-header-container {\n        padding: 0 24px;\n    }\n    .s-header-menu {\n        gap: 16px;\n    }\n}\n\n@media (max-width: 768px) {\n    .s-header-hamburger {\n        display: flex;\n    }\n\n    .s-header-nav {\n        position: fixed;\n        top: 0;\n        right: -100%;\n        width: 80%;\n        height: 100vh;\n        background-color: var(--s-header-bg);\n        flex-direction: column;\n        justify-content: center;\n        transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n        box-shadow: -10px 0 30px rgba(0,0,0,0.05);\n    }\n\n    .s-header-nav.active {\n        right: 0;\n    }\n\n    .s-header-menu {\n        flex-direction: column;\n        gap: 32px;\n        text-align: center;\n    }\n\n    .s-header-link {\n        font-size: 18px;\n    }\n\n    .s-header-actions {\n        flex-direction: column;\n        gap: 24px;\n        text-align: center;\n        margin-top: 20px;\n    }\n\n    .s-header-btn-primary {\n        width: 200px;\n        text-align: center;\n    }\n}\n\n@media (max-width: 480px) {\n    .s-header-container {\n        padding: 0 16px;\n    }\n    .s-header-logo {\n        font-size: 20px;\n    }\n}\n</style>\n\n<header class=\"s-header-wrapper\">\n    <nav class=\"s-header-container\">\n        <a href=\"/\" class=\"s-header-logo\">Scaler</a>\n        \n        <div class=\"s-header-hamburger\" id=\"s-header-toggle\">\n            <span></span>\n            <span></span>\n            <span></span>\n        </div>\n\n        <div class=\"s-header-nav\" id=\"s-header-menu\">\n            <ul class=\"s-header-menu\">\n                <li><a href=\"#\" class=\"s-header-link\">Masterclass</a></li>\n                <li><a href=\"#\" class=\"s-header-link\">AI Labs</a></li>\n                <li><a href=\"#\" class=\"s-header-link\">Alumni</a></li>\n                <li><a href=\"#\" class=\"s-header-link\">Placement Report</a></li>\n            </ul>\n            <div class=\"s-header-actions\">\n                <a href=\"#\" class=\"s-header-btn-secondary\">Login</a>\n                <a href=\"#\" class=\"s-header-btn-primary\">Join Now</a>\n            </div>\n        </div>\n    </nav>\n</header>\n\n<script>\n    document.getElementById('s-header-toggle').addEventListener('click', function() {\n        const menu = document.getElementById('s-header-menu');\n        menu.classList.toggle('active');\n        \n        // Animate hamburger to X\n        const spans = this.querySelectorAll('span');\n        spans[0].style.transform = menu.classList.contains('active') ? 'rotate(45deg) translate(5px, 6px)' : 'none';\n        spans[1].style.opacity = menu.classList.contains('active') ? '0' : '1';\n        spans[2].style.transform = menu.classList.contains('active') ? 'rotate(-45deg) translate(5px, -6px)' : 'none';\n    });\n</script>","model":"gemma-4-31b-it","ts":1778074239892}