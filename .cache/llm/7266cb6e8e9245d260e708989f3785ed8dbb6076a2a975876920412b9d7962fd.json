{"text":"<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');\n\n:root {\n    --s-hero-primary: #004ce5;\n    --s-hero-primary-dark: #00236e;\n    --s-hero-text-main: #011a53;\n    --s-hero-text-muted: #616161;\n    --s-hero-bg: #ffffff;\n    --s-hero-bg-alt: #fafafa;\n    --s-hero-white: #ffffff;\n    --s-hero-font: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;\n}\n\n.s-hero-section {\n    position: relative;\n    width: 100%;\n    min-height: 90vh;\n    background-color: var(--s-hero-bg);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    font-family: var(--s-hero-font);\n    padding: 80px 20px;\n    box-sizing: border-box;\n}\n\n/* Decorative Background Elements */\n.s-hero-glow {\n    position: absolute;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(0, 76, 229, 0.1) 0%, rgba(255, 255, 255, 0) 70%);\n    top: -200px;\n    right: -100px;\n    z-index: 1;\n    pointer-events: none;\n}\n\n.s-hero-glow-bottom {\n    position: absolute;\n    width: 500px;\n    height: 500px;\n    background: radial-gradient(circle, rgba(0, 35, 110, 0.05) 0%, rgba(255, 255, 255, 0) 70%);\n    bottom: -100px;\n    left: -100px;\n    z-index: 1;\n    pointer-events: none;\n}\n\n.s-hero-container {\n    position: relative;\n    z-index: 2;\n    max-width: 1200px;\n    width: 100%;\n    text-align: center;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 0 40px;\n}\n\n.s-hero-badge {\n    display: inline-block;\n    padding: 8px 16px;\n    background: rgba(0, 76, 229, 0.08);\n    color: var(--s-hero-primary);\n    font-size: 14px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    border-radius: 100px;\n    margin-bottom: 24px;\n    transition: all 0.3s ease;\n}\n\n.s-hero-title {\n    font-size: 64px;\n    font-weight: 800;\n    color: var(--s-hero-text-main);\n    line-height: 1.1;\n    margin: 0 0 24px 0;\n    max-width: 900px;\n    letter-spacing: -1px;\n}\n\n.s-hero-subtitle {\n    font-size: 20px;\n    line-height: 1.6;\n    color: var(--s-hero-text-muted);\n    max-width: 700px;\n    margin: 0 0 40px 0;\n}\n\n.s-hero-cta-group {\n    display: flex;\n    gap: 16px;\n    flex-wrap: wrap;\n    justify-content: center;\n}\n\n.s-hero-btn {\n    padding: 18px 36px;\n    font-size: 16px;\n    font-weight: 600;\n    border-radius: 8px;\n    cursor: pointer;\n    transition: all 0.3s ease;\n    text-decoration: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.s-hero-btn-primary {\n    background-color: var(--s-hero-primary);\n    color: var(--s-hero-white);\n    border: 2px solid var(--s-hero-primary);\n}\n\n.s-hero-btn-primary:hover {\n    background-color: var(--s-hero-primary-dark);\n    border-color: var(--s-hero-primary-dark);\n    transform: translateY(-2px);\n    box-shadow: 0 10px 20px rgba(0, 76, 229, 0.2);\n}\n\n.s-hero-btn-secondary {\n    background-color: transparent;\n    color: var(--s-hero-text-main);\n    border: 2px solid #e0e0e0;\n}\n\n.s-hero-btn-secondary:hover {\n    border-color: var(--s-hero-primary);\n    color: var(--s-hero-primary);\n    transform: translateY(-2px);\n}\n\n/* Responsive Design */\n@media (max-width: 768px) {\n    .s-hero-section {\n        padding: 60px 20px;\n        min-height: auto;\n    }\n    .s-hero-title {\n        font-size: 48px;\n    }\n    .s-hero-subtitle {\n        font-size: 18px;\n    }\n    .s-hero-container {\n        padding: 0 20px;\n    }\n}\n\n@media (max-width: 480px) {\n    .s-hero-title {\n        font-size: 36px;\n    }\n    .s-hero-subtitle {\n        font-size: 16px;\n    }\n    .s-hero-cta-group {\n        flex-direction: column;\n        width: 100%;\n    }\n    .s-hero-btn {\n        width: 100%;\n    }\n}\n</style>\n\n<section class=\"s-hero-section\">\n    <div class=\"s-hero-glow\"></div>\n    <div class=\"s-hero-glow-bottom\"></div>\n    \n    <div class=\"s-hero-container\">\n        <span class=\"s-hero-badge\">Built Different, Designed to Last</span>\n        <h1 class=\"s-hero-title\">Become the Professional Built for the Next Decade in AI.</h1>\n        <p class=\"s-hero-subtitle\">\n            The investment that compounds. Scaler gives you strong technical foundations, AI integrated at every stage, and a curriculum that evolves as the market does.\n        </p>\n        <div class=\"s-hero-cta-group\">\n            <a href=\"#\" class=\"s-hero-btn s-hero-btn-primary\">Apply Now</a>\n            <a href=\"#\" class=\"s-hero-btn s-hero-btn-secondary\">Explore Programs</a>\n        </div>\n    </div>\n</section>","model":"gemma-4-31b-it","ts":1778074247456}